<%- include('../partials/header') %>

<a href="/shop" class="btn btn-sm btn-outline-brand mb-4">&larr; Back to shop</a>

<div class="row g-5">
  <div class="col-md-6">
    <% if (images.length) { %>
      <div class="surface overflow-hidden mb-3">
        <img src="<%= images[0].image_url %>" class="img-fluid w-100"
             alt="<%= images[0].alt_text || product.name %>">
      </div>
      <div class="row g-2">
        <% images.slice(1).forEach(img => { %>
          <div class="col-4">
            <div class="surface overflow-hidden">
              <img src="<%= img.image_url %>" class="img-fluid w-100"
                   alt="<%= img.alt_text || product.name %>" loading="lazy">
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="surface overflow-hidden">
        <img src="https://placehold.co/600x800/FAF8FC/8B8398?text=Denise" class="img-fluid w-100"
             alt="<%= product.name %>">
      </div>
    <% } %>
  </div>

  <div class="col-md-6">
    <div class="eyebrow mb-2"><%= product.category %> · <%= product.department %></div>
    <h1 class="mb-2"><%= product.name %></h1>
    <p class="fs-4 fw-semibold mb-4">$<%= Number(product.price).toFixed(2) %></p>
    <p class="text-soft"><%= product.description %></p>

    <% if (typeof query !== 'undefined' && query.error === 'stock') { %>
      <div class="flash flash--warning mb-3">
        <span>Not enough stock for that selection. Please choose a smaller quantity.</span>
      </div>
    <% } %>

    <% if (variants.length === 0) { %>

      <div class="flash flash--info mt-4"><span>This piece is currently unavailable.</span></div>

    <% } else if (variants.every(v => Number(v.stock_quantity) === 0)) { %>

      <div class="flash flash--info mt-4"><span>Sold out. Check back soon.</span></div>

    <% } else { %>

      <form method="POST" action="/cart/add" class="mt-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="slug" value="<%= product.slug %>">

        <div class="mb-3">
          <label class="form-label">Size and colour</label>
          <select name="variant_id" class="form-select" required>
            <option value="">Choose an option</option>
            <% variants.forEach(v => { %>
              <option value="<%= v.id %>"
                      <%= Number(v.stock_quantity) === 0 ? 'disabled' : '' %>>
                <%= v.color %> · Size <%= v.size %>
                <% if (Number(v.stock_quantity) === 0) { %>
                  — sold out
                <% } else if (Number(v.stock_quantity) <= 3) { %>
                  — only <%= v.stock_quantity %> left
                <% } %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="mb-4" style="max-width: 130px;">
          <label class="form-label">Quantity</label>
          <input type="number" name="quantity" class="form-control" value="1" min="1" required>
        </div>

        <button class="btn btn-brand btn-lg w-100"><span>Add to cart</span></button>
      </form>

      <div class="d-flex gap-4 mt-4 pt-3" style="border-top:1px solid var(--line);">
        <div class="small text-mute">Flat $5 shipping</div>
        <div class="small text-mute">30-day returns</div>
      </div>

    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>