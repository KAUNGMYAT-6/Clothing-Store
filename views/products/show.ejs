<%- include('../partials/header') %>

<a href="/" class="btn btn-sm btn-outline-dark mb-3">&larr; Back to products</a>

<div class="row">
  <div class="col-md-6">
    <% if (images.length) { %>
      <img src="<%= images[0].image_url %>" class="img-fluid rounded mb-3"
           alt="<%= images[0].alt_text || product.name %>">
      <div class="row g-2">
        <% images.slice(1).forEach(img => { %>
          <div class="col-4">
            <img src="<%= img.image_url %>" class="img-fluid rounded"
                 alt="<%= img.alt_text || product.name %>">
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <img src="https://placehold.co/600x800?text=No+Image" class="img-fluid rounded"
           alt="<%= product.name %>">
    <% } %>
  </div>

  <div class="col-md-6">
    <p class="text-muted mb-1"><%= product.category %> &middot; <%= product.department %></p>
    <h1><%= product.name %></h1>
    <p class="fs-3 fw-bold">$<%= product.price %></p>
    <p><%= product.description %></p>

    <% if (typeof query !== 'undefined' && query.error === 'stock') { %>
      <div class="alert alert-warning">
        Not enough stock for that selection. Please choose a smaller quantity.
      </div>
    <% } %>

    <form method="POST" action="/cart/add" class="mt-4">
      <input type="hidden" name="slug" value="<%= product.slug %>">

      <div class="mb-3">
        <label class="form-label">Size and colour</label>
        <select name="variant_id" class="form-select" required>
          <option value="">Choose an option</option>
          <% variants.forEach(v => { %>
            <option value="<%= v.id %>" <%= v.stock_quantity === 0 ? 'disabled' : '' %>>
              <%= v.color %> &middot; Size <%= v.size %>
              <% if (v.stock_quantity === 0) { %>
                &mdash; sold out
              <% } else if (v.stock_quantity <= 3) { %>
                &mdash; only <%= v.stock_quantity %> left
              <% } %>
            </option>
          <% }) %>
        </select>
      </div>

      <div class="mb-3" style="max-width: 120px;">
        <label class="form-label">Quantity</label>
        <input type="number" name="quantity" class="form-control" value="1" min="1" required>
      </div>

      <button class="btn btn-dark btn-lg w-100">Add to cart</button>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>