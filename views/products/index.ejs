<%- include('../partials/header') %>

<div class="section-head">
  <div>
    <div class="eyebrow mb-1">Collection</div>
    <h1 class="mb-0">All products</h1>
  </div>
</div>

<form class="row g-2 mb-4" method="GET" action="/shop">
  <div class="col-md-4">
    <input type="text" name="q" class="form-control" placeholder="Search products"
           value="<%= filters.q || '' %>">
  </div>

  <div class="col-md-3">
    <select name="category" class="form-select">
      <option value="">All categories</option>
      <% categories.forEach(c => { %>
        <option value="<%= c.id %>" <%= filters.category == c.id ? 'selected' : '' %>>
          <%= c.name %>
        </option>
      <% }) %>
    </select>
  </div>

  <div class="col-md-3">
    <select name="department" class="form-select">
      <option value="">All departments</option>
      <% ['men','women','unisex'].forEach(d => { %>
        <option value="<%= d %>" <%= filters.department === d ? 'selected' : '' %>><%= d %></option>
      <% }) %>
    </select>
  </div>

  <div class="col-md-2 d-grid">
    <button class="btn btn-brand"><span>Filter</span></button>
  </div>
</form>

<% if (products.length === 0) { %>

  <div class="empty-state">
    <h3 class="h5 mb-2">No matches</h3>
    <p class="text-mute mb-3">Nothing fits those filters. Try widening your search.</p>
    <a href="/shop" class="btn btn-outline-brand">Clear filters</a>
  </div>

<% } else { %>

  <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 g-md-4">
    <% products.forEach(product => { %>
      <div class="col">
        <a href="/products/<%= product.slug %>" class="text-decoration-none">
          <article class="product-card">
            <div class="product-card__media">
              <img src="<%= product.image_url || 'https://placehold.co/600x800/FAF8FC/8B8398?text=Denise' %>"
                   alt="<%= product.alt_text || product.name %>" loading="lazy">
              <% if (Number(product.total_stock) === 0) { %>
                <div class="media-overlay">Sold out</div>
              <% } %>
            </div>
            <div class="product-card__body">
              <h3 class="product-card__name"><%= product.name %></h3>
              <div class="product-card__meta"><%= product.category %> · <%= product.department %></div>
              <div class="product-card__price">$<%= Number(product.price).toFixed(2) %></div>
            </div>
          </article>
        </a>
      </div>
    <% }) %>
  </div>

<% } %>

<%- include('../partials/footer') %>