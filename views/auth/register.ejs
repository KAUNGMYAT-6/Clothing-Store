<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="text-center mb-4">
      <div class="eyebrow mb-2">Join Denise</div>
      <h1>Create your account</h1>
    </div>

    <div class="surface p-4 p-md-5">
      <% if (locals.error) { %>
        <div class="flash flash--error mb-3">
          <span class="flash__icon" aria-hidden="true">✕</span>
          <span class="flash__text"><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/register" id="registerForm" data-password-match>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label for="name" class="form-label">Full name</label>
          <input id="name" type="text" name="name" class="form-control" required
                 value="<%= locals.values && values.name ? values.name : '' %>">
        </div>

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input id="email" type="email" name="email" class="form-control" required
                 value="<%= locals.values && values.email ? values.email : '' %>">
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input id="password" type="password" name="password" class="form-control"
                 minlength="8" required data-password>
          <div class="form-text">At least 8 characters.</div>
        </div>

        <div class="mb-4">
          <label for="confirm_password" class="form-label">Confirm password</label>
          <input id="confirm_password" type="password" name="confirm_password" class="form-control"
                 minlength="8" required data-password-confirm>
          <div class="form-text" data-password-hint></div>
        </div>

        <button class="btn btn-accent btn-lg w-100">Create account</button>
      </form>

      <div class="d-flex align-items-center gap-3 my-3">
        <span style="flex:1; height:1px; background:var(--line)"></span>
        <span class="text-mute" style="font-size:.78rem">or</span>
        <span style="flex:1; height:1px; background:var(--line)"></span>
      </div>

      <a href="/auth/google" class="google-btn" aria-label="Continue with Google">
        <img src="/img/google-signin.svg" alt="Sign in with Google">
      </a>
    </div>

    <p class="text-center text-mute mt-3" style="font-size:.88rem">
      Already have an account? <a href="/login">Log in</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>