<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="text-center mb-4">
      <div class="eyebrow mb-2">Welcome back</div>
      <h1>Log in</h1>
    </div>

    <div class="surface p-4 p-md-5">
      <% if (error) { %>
        <div class="flash flash--error mb-3">
          <span class="flash__icon" aria-hidden="true">✕</span>
          <span class="flash__text"><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input id="email" type="email" name="email" class="form-control" required autofocus>
        </div>

        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-baseline">
            <label for="password" class="form-label">Password</label>
            <a href="/forgot-password" style="font-size:.78rem">Forgot?</a>
          </div>
          <input id="password" type="password" name="password" class="form-control" required>
        </div>

        <button class="btn btn-accent btn-lg w-100">Log in</button>
      </form>

      <div class="d-flex align-items-center gap-3 my-3">
        <span style="flex:1; height:1px; background:var(--line)"></span>
        <span class="text-mute" style="font-size:.78rem">or</span>
        <span style="flex:1; height:1px; background:var(--line)"></span>
      </div>

      <a href="/auth/google" class="google-btn" aria-label="Continue with Google">
        <img src="/img/google-signin.svg" alt="Sign in with Google">
      </a>
    </div>

    <p class="text-center text-mute mt-3" style="font-size:.88rem">
      New here? <a href="/register">Create an account</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>