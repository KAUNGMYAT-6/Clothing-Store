<%- include('partials/header') %>

<div style="font-size:.82rem; color:var(--ink-mute)" class="mb-3">
  <a href="/admin" class="text-mute">Admin</a> <span style="opacity:.5">/</span>
  <a href="/admin/products" class="text-mute">Products</a> <span style="opacity:.5">/</span>
  <span class="text-soft">New</span>
</div>

<h1 class="mb-4">New product</h1>

<form method="POST"
      action="/admin/products?_csrf=<%= encodeURIComponent(csrfToken) %>"
      enctype="multipart/form-data"
      data-live-preview>

  <div class="row g-3">
    <div class="col-lg-8">
      <div class="panel p-4">
        <% if (error) { %>
          <div class="flash flash--error mb-4">
            <span class="flash__icon" aria-hidden="true">✕</span>
            <span class="flash__text"><%= error %></span>
          </div>
        <% } %>

        <div class="mb-3">
          <label for="name" class="form-label">Name</label>
          <input id="name" type="text" name="name" class="form-control" required
                 data-preview-source="name" value="<%= product ? product.name : '' %>">
        </div>

        <div class="mb-3">
          <label for="slug" class="form-label">URL slug</label>
          <input id="slug" type="text" name="slug" class="form-control" required
                 pattern="[a-z0-9-]+" value="<%= product ? product.slug : '' %>">
          <div class="form-text">Lowercase letters, numbers and hyphens only.</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea id="description" name="description" class="form-control" rows="3"><%= product ? product.description : '' %></textarea>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-4">
            <label for="price" class="form-label">Price (SGD)</label>
            <input id="price" type="number" name="price" step="0.01" min="0" class="form-control"
                   required data-preview-source="price" value="<%= product ? product.price : '' %>">
          </div>
          <div class="col-md-4">
            <label for="category_id" class="form-label">Category</label>
            <select id="category_id" name="category_id" class="form-select" required>
              <% categories.forEach(function (c) { %>
                <option value="<%= c.id %>" <%= product && product.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label for="department" class="form-label">Department</label>
            <select id="department" name="department" class="form-select" data-preview-source="department">
              <% ['women','men','unisex'].forEach(function (d) { %>
                <option value="<%= d %>" <%= product && product.department === d ? 'selected' : '' %>><%= d %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <!-- SIZES AND STOCK -->
        <div class="mb-4 pt-3" style="border-top:1px solid var(--line-soft)">
          <div class="d-flex justify-content-between align-items-baseline flex-wrap gap-1 mb-2">
            <span class="form-label mb-0">Sizes and stock</span>
            <span class="text-mute" style="font-size:.76rem">Empty rows are ignored</span>
          </div>

          <div class="variant-rows" data-variant-rows>
            <div class="variant-row variant-row--head" aria-hidden="true">
              <span>Colour</span><span>Size</span><span>Stock</span><span></span>
            </div>
            <% variantRows.forEach(function (row) { %>
              <%- include('partials/variant-row', { row: row }) %>
            <% }) %>
          </div>

          <%# Copied by app.js when "Add another row" is clicked %>
          <template data-variant-template>
            <%- include('partials/variant-row', { row: { color: '', size: '', stock: '' } }) %>
          </template>

          <button type="button" class="btn btn-sm btn-soft mt-2" data-add-variant-row data-js-only hidden>
            + Add another row
          </button>
          <div class="form-text">SKUs are created for you. You can add more sizes later on the edit page.</div>

          <datalist id="size-suggestions">
            <% sizeSuggestions.forEach(function (s) { %><option value="<%= s %>"><% }) %>
          </datalist>
          <datalist id="colour-suggestions">
            <% colourSuggestions.forEach(function (c) { %><option value="<%= c %>"><% }) %>
          </datalist>
        </div>

        <div class="mb-4 pt-3" style="border-top:1px solid var(--line-soft)">
          <label for="image" class="form-label">Main image</label>
          <input id="image" type="file" name="image" class="form-control"
                 accept="image/jpeg,image/png,image/webp,image/avif" data-preview-file>
          <div class="form-text">JPEG, PNG, WebP or AVIF. Max 5 MB. You can add more images after creating.</div>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-accent">Create product</button>
          <a href="/admin/products" class="btn btn-plain">Cancel</a>
        </div>
      </div>
    </div>

    <!-- LIVE PREVIEW -->
    <div class="col-lg-4">
      <div class="panel p-4">
        <div class="panel-title mb-1">Store preview</div>
        <div class="text-mute mb-3" style="font-size:.78rem">Updates as you type.</div>

        <div class="product-card" style="pointer-events:none">
          <div class="product-card__media">
            <img data-preview-image
                 src="https://placehold.co/600x800/EEF2FF/8785A8?text=No+image" alt="">
          </div>
          <div class="product-card__body">
            <div class="product-card__name" data-preview-name>Product name</div>
            <div class="product-card__meta" data-preview-department>unisex</div>
            <div class="product-card__price" data-preview-price>$0.00</div>
            <div class="text-mute mt-1" style="font-size:.76rem" data-preview-stock>No sizes yet</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</form>

<%- include('partials/footer') %>