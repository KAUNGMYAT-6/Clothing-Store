<%- include('partials/header') %>

<div style="font-size:.82rem; color:var(--ink-mute)" class="mb-3">
  <a href="/admin" class="text-mute">Admin</a> <span style="opacity:.5">/</span>
  <a href="/admin/products" class="text-mute">Products</a> <span style="opacity:.5">/</span>
  <span class="text-soft">New</span>
</div>

<h1 class="mb-4">New product</h1>

<div class="row">
  <div class="col-lg-7">
    <div class="panel p-4">
      <% if (error) { %>
        <div class="flash flash--error mb-4">
          <span class="flash__icon" aria-hidden="true">✕</span>
          <span class="flash__text"><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/admin/products">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label for="name" class="form-label">Name</label>
          <input id="name" type="text" name="name" class="form-control" required
                 value="<%= product ? product.name : '' %>">
        </div>

        <div class="mb-3">
          <label for="slug" class="form-label">URL slug</label>
          <input id="slug" type="text" name="slug" class="form-control" required
                 pattern="[a-z0-9-]+" value="<%= product ? product.slug : '' %>">
          <div class="form-text">Lowercase letters, numbers and hyphens only.</div>
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea id="description" name="description" class="form-control" rows="4"><%= product ? product.description : '' %></textarea>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label for="price" class="form-label">Price (SGD)</label>
            <input id="price" type="number" name="price" step="0.01" min="0"
                   class="form-control" required value="<%= product ? product.price : '' %>">
          </div>
          <div class="col-md-4">
            <label for="category_id" class="form-label">Category</label>
            <select id="category_id" name="category_id" class="form-select" required>
              <% categories.forEach(function (c) { %>
                <option value="<%= c.id %>" <%= product && product.category_id == c.id ? 'selected' : '' %>>
                  <%= c.name %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-4">
            <label for="department" class="form-label">Department</label>
            <select id="department" name="department" class="form-select">
              <% ['women','men','unisex'].forEach(function (d) { %>
                <option value="<%= d %>" <%= product && product.department === d ? 'selected' : '' %>><%= d %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="d-flex gap-2">
          <button class="btn btn-accent">Create product</button>
          <a href="/admin/products" class="btn btn-plain">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <div class="col-lg-5">
    <div class="panel p-4">
      <div class="panel-title mb-2">What happens next</div>
      <p class="text-mute mb-0" style="font-size:.86rem">
        After creating the product you'll land on its edit page, where you add sizes,
        colours and images. A product with no variants can't be bought, so it won't
        appear as available until you add at least one.
      </p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>