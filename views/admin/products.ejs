<%- include('partials/header') %>

<div class="d-flex align-items-end justify-content-between flex-wrap gap-3 mb-4">
  <div>
    <div class="eyebrow mb-1">Manage</div>
    <h1>Products</h1>
  </div>
  <a href="/admin/products/new" class="btn btn-accent">
    <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
    New product
  </a>
</div>

<div class="panel overflow-hidden">
  <% if (products.length === 0) { %>

    <div class="p-5 text-center">
      <h3 class="h6 mb-2">No products yet</h3>
      <p class="text-mute mb-3">Add your first product to get the shop going.</p>
      <a href="/admin/products/new" class="btn btn-accent">New product</a>
    </div>

  <% } else { %>

    <div class="table-responsive">
      <table class="table-clean">
        <thead>
          <tr>
            <th>Product</th>
            <th>Category</th>
            <th>Dept</th>
            <th class="text-end">Price</th>
            <th class="text-center">Variants</th>
            <th class="text-center">Stock</th>
            <th>Status</th>
            <th style="width:72px"></th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function (p) {
               const stock = Number(p.total_stock);
               const variants = Number(p.variant_count);
               let stockCls = '';
               if (stock === 0) stockCls = 'stock-zero';
               else if (stock <= 5) stockCls = 'stock-low';
          %>
            <tr>
              <td>
                <div class="font-display fw-semibold"><%= p.name %></div>
                <div class="text-mute" style="font-size:.76rem"><%= p.slug %></div>
              </td>
              <td class="text-mute" style="font-size:.84rem"><%= p.category %></td>
              <td class="text-mute" style="font-size:.84rem"><%= p.department %></td>
              <td class="text-end font-display fw-bold">$<%= Number(p.price).toFixed(2) %></td>
              <td class="text-center">
                <% if (variants === 0) { %>
                  <span class="badge-soft is-danger">none</span>
                <% } else { %>
                  <%= variants %>
                <% } %>
              </td>
              <td class="text-center <%= stockCls %>"><%= stock %></td>
              <td>
                <% if (p.is_active) { %>
                  <span class="badge-soft is-success">Live</span>
                <% } else { %>
                  <span class="badge-soft is-out">Hidden</span>
                <% } %>
              </td>
              <td class="text-end">
                <a href="/admin/products/<%= p.id %>/edit" class="btn btn-sm btn-soft">Edit</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  <% } %>
</div>

<%- include('partials/footer') %>