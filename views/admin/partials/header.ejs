<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Denise Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<div class="admin-shell">

  <!-- SIDEBAR -->
  <aside class="admin-side">
    <a href="/" class="admin-side__brand">
      DENISE<span style="position:absolute; left:.4rem; bottom:0; width:24px; height:3px; border-radius:2px; background:var(--orange-500)"></span>
      <span class="admin-side__tag">Admin</span>
    </a>

    <nav class="d-flex flex-column gap-1">
      <a href="/admin" class="side-link <%= active === 'dashboard' ? 'is-on' : '' %>">
        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
        Dashboard
      </a>

      <a href="/admin/orders" class="side-link <%= active === 'orders' ? 'is-on' : '' %>">
        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h12l2 6H4z"/><path d="M4 8v12a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8"/><path d="M9 12h6"/></svg>
        Orders
        <% if (typeof pendingCount !== 'undefined' && pendingCount > 0) { %>
          <span class="side-count"><%= pendingCount %></span>
        <% } %>
      </a>

      <a href="/admin/products" class="side-link <%= active === 'products' ? 'is-on' : '' %>">
        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4 4 6l2 4 2-1v11h8V9l2 1 2-4-4-2a4 4 0 0 1-8 0Z"/></svg>
        Products
      </a>
    </nav>

    <div class="mt-auto d-flex flex-column gap-1">
      <a href="/" class="side-link">
        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5l-7 7 7 7"/><path d="M20 12H7"/></svg>
        Back to store
      </a>

      <div class="d-flex align-items-center gap-2 px-3 py-3 mt-1" style="border-top:1px solid rgba(255,255,255,.1)">
        <div style="width:30px; height:30px; border-radius:9px; background:var(--orange-500); color:#fff; font-family:'Outfit',sans-serif; font-weight:700; font-size:.8rem; display:flex; align-items:center; justify-content:center; flex-shrink:0">
          <%= user.name.trim().charAt(0).toUpperCase() %>
        </div>
        <div style="min-width:0">
          <div class="text-white text-truncate" style="font-size:.82rem; font-weight:600"><%= user.name %></div>
          <div style="color:rgba(255,255,255,.45); font-size:.72rem">Administrator</div>
        </div>
      </div>

      <form method="POST" action="/logout" class="px-3 pb-2">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm w-100" style="background:rgba(255,255,255,.08); color:rgba(255,255,255,.75)">Log out</button>
      </form>
    </div>
  </aside>

  <!-- MAIN -->
  <div class="admin-main p-4 p-lg-5" style="min-width:0">
    <%- include('../../partials/flash') %>