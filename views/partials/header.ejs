<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · DeniseClothing' : 'DeniseClothing' %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<!-- Keyboard users can jump straight past the nav -->
<a href="#main" class="skip-link">Skip to content</a>

<header class="site-nav">
  <div class="container">
    <nav class="navbar navbar-expand-lg px-0">

      <a class="brand" href="/">DENISE</a>

      <button class="navbar-toggler ms-auto" type="button"
              data-bs-toggle="collapse" data-bs-target="#mainNav"
              aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="mainNav">

        <!-- CATEGORIES -->
        <ul class="navbar-nav ms-lg-4 mb-2 mb-lg-0 align-items-lg-center">
          <li class="nav-item"><a class="nav-link" href="/shop">Shop all</a></li>
          <li class="nav-item"><a class="nav-link" href="/shop?department=women">Women</a></li>
          <li class="nav-item"><a class="nav-link" href="/shop?department=men">Men</a></li>
          <li class="nav-item"><a class="nav-link" href="/shop?department=unisex">Unisex</a></li>

          <% if (navCategories && navCategories.length) { %>
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" id="catDrop" role="button"
                 data-bs-toggle="dropdown" aria-expanded="false">Categories</a>
              <ul class="dropdown-menu" aria-labelledby="catDrop">
                <% navCategories.forEach(function (c) { %>
                  <li><a class="dropdown-item" href="/shop?category=<%= c.id %>"><%= c.name %></a></li>
                <% }) %>
              </ul>
            </li>
          <% } %>
        </ul>

        <!-- SEARCH
             Hidden on /shop, which has its own filter bar. The empty div
             keeps the right-hand items pushed right when the form is gone. -->
        <% if (locals.path !== '/shop') { %>
          <form class="d-flex ms-lg-auto my-2 my-lg-0 me-lg-3" method="GET" action="/shop" role="search">
            <label for="nav-search" class="visually-hidden">Search products</label>
            <input id="nav-search" type="search" name="q" class="form-control form-control-sm"
                   placeholder="Search" style="min-width:170px">
          </form>
        <% } else { %>
          <div class="ms-lg-auto"></div>
        <% } %>

        <!-- RIGHT SIDE -->
        <div class="d-flex align-items-center gap-2 flex-wrap">

          <% if (user) { %>
            <div class="dropdown">
              <button class="nav-avatar" type="button" id="userMenu"
                      data-bs-toggle="dropdown" aria-expanded="false"
                      aria-label="Account menu">
                <% if (user.profile_photo_url) { %>
                  <img src="<%= user.profile_photo_url %>" alt="">
                <% } else { %>
                  <span><%= (user.name || user.email).trim().charAt(0).toUpperCase() %></span>
                <% } %>
              </button>

              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
                <li class="dropdown-header">
                  <div class="fw-semibold text-dark"><%= user.name %></div>
                  <div class="text-mute text-truncate" style="font-size:.76rem; max-width:180px">
                    <%= user.email %>
                  </div>
                </li>
                <li><hr class="dropdown-divider"></li>

                <li><a class="dropdown-item" href="/account/orders">My orders</a></li>
                <li><a class="dropdown-item" href="/account/addresses">Addresses</a></li>
                <li><a class="dropdown-item" href="/account/settings">Settings</a></li>

                <% if (user.role === 'admin') { %>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="/admin">Admin panel</a></li>
                <% } %>

                <li><hr class="dropdown-divider"></li>
                <li>
                  <form method="POST" action="/logout" class="px-3 py-1">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-sm btn-plain w-100">Log out</button>
                  </form>
                </li>
              </ul>
            </div>

          <% } else { %>

            <a href="/login" class="nav-link">Log in</a>
            <a href="/register" class="btn btn-sm btn-accent">Sign up</a>

          <% } %>

          <!-- CART -->
          <a href="/cart" class="cart-link" aria-label="Cart">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <path d="M3 6h18"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
            <span class="cart-badge" data-cart-count><%= cartCount || 0 %></span>
          </a>

        </div>
      </div>
    </nav>
  </div>
</header>

<main id="main" class="container py-4">

<%# Flash messages queued by req.flash() on the previous request %>
<%- include('flash') %>
