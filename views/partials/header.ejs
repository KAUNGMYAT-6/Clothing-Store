<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Denise</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="site-nav">
  <div class="container">
    <div class="d-flex align-items-center justify-content-between py-3 gap-3">

      <a href="/" class="brand">Denise<span>Clothing</span></a>

      <div class="d-none d-md-flex align-items-center gap-1">
        <a href="/shop" class="nav-link-custom">Shop</a>
        <a href="/shop?department=women" class="nav-link-custom">Women</a>
        <a href="/shop?department=men" class="nav-link-custom">Men</a>
      </div>

      <div class="d-flex align-items-center gap-2">
        <a href="/cart" class="cart-pill">
          Cart <span class="count"><%= cartCount %></span>
        </a>

        <% if (user) { %>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="nav-link-custom d-none d-sm-inline">Admin</a>
          <% } %>
          <span class="d-none d-lg-inline text-mute small"><%= user.name %></span>
          <form method="POST" action="/logout" class="d-inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-sm btn-ghost">Log out</button>
          </form>
        <% } else { %>
          <a href="/login" class="nav-link-custom d-none d-sm-inline">Log in</a>
          <a href="/register" class="btn btn-sm btn-brand"><span>Sign up</span></a>
        <% } %>
      </div>

    </div>
  </div>
</nav>

<main class="container py-5">
  <%- include('flash') %>