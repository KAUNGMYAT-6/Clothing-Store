<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · DeniseClothing</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="site-nav">
  <div class="container">
    <div class="d-flex align-items-center justify-content-between py-3 gap-3">

      <a href="/" class="brand">DENISE</a>

      <div class="d-none d-lg-flex align-items-center gap-4">
        <a href="/shop" class="nav-item-link">Shop all</a>

        <div class="nav-drop">
          <a href="/shop" class="nav-item-link">Categories</a>
          <div class="nav-drop__menu">
            <% (navCategories || []).forEach(c => { %>
              <a href="/shop?category=<%= c.id %>">
                <span><%= c.name %></span>
                <span class="count"><%= c.product_count %></span>
              </a>
            <% }) %>
          </div>
        </div>

        <a href="/shop?department=women" class="nav-item-link">Women</a>
        <a href="/shop?department=men" class="nav-item-link">Men</a>
      </div>

      <div class="d-flex align-items-center gap-2">
        <a href="/cart" class="cart-pill" id="cartPill">
          Cart <span class="count"><%= cartCount %></span>
        </a>

        <% if (user) { %>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="nav-ghost d-none d-sm-inline">Admin</a>
          <% } %>
          <a href="/account" class="nav-ghost d-none d-md-inline"><%= user.name.split(' ')[0] %></a>
          <form method="POST" action="/logout" class="d-inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="nav-ghost">Log out</button>
          </form>
        <% } else { %>
          <a href="/login" class="nav-ghost d-none d-sm-inline">Log in</a>
          <a href="/register" class="btn btn-sm btn-accent">Sign up</a>
        <% } %>
      </div>

    </div>
  </div>
</nav>

<main class="container py-4 py-md-5">
  <%- include('flash') %>