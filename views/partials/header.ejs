<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="/">Clothing Store</a>

    <div class="ms-auto d-flex align-items-center">
      <a href="/cart" class="btn btn-sm btn-outline-light me-2">
        Cart <span class="badge bg-light text-dark"><%= cartCount %></span>
      </a>

      <% if (user) { %>
        <span class="text-light me-3"><%= user.name %></span>
        <form method="POST" action="/logout" class="d-inline">
          <button class="btn btn-sm btn-outline-light">Log out</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-sm btn-outline-light me-2">Log in</a>
        <a href="/register" class="btn btn-sm btn-light">Register</a>
      <% } %>
    </div>
  </div>
</nav>
<main class="container py-4">