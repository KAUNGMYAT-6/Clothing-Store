<%- include('../partials/header') %>

<div style="font-size:.82rem; color:var(--ink-mute)" class="mb-3">
  <a href="/cart" class="text-mute">Cart</a> <span style="opacity:.5">/</span>
  <span class="text-soft">Checkout</span>
</div>

<div class="section-head">
  <div>
    <div class="eyebrow mb-1">Almost there</div>
    <h1>Checkout</h1>
  </div>
</div>

<div class="row g-4">

  <!-- FORM -->
  <div class="col-lg-7">
    <% if (error) { %>
      <div class="flash flash--error mb-3">
        <span class="flash__icon" aria-hidden="true">✕</span>
        <span class="flash__text"><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/checkout/session">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="surface p-4 mb-3">
        <div class="panel-title mb-3">Contact</div>
        <div>
          <label for="email" class="form-label">Email</label>
          <input id="email" type="email" name="email" class="form-control" required
                 autocomplete="email" value="<%= email %>">
          <div class="form-text">Your order confirmation goes here.</div>
        </div>
      </div>

      <div class="surface p-4 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div class="panel-title">Delivery address</div>
          <% if (addresses.length) { %>
            <a href="/account/addresses" class="text-mute" style="font-size:.8rem">Manage addresses</a>
          <% } %>
        </div>

        <% if (addresses.length) { %>
          <div class="d-flex flex-column gap-2 mb-3" role="radiogroup" aria-label="Delivery address">
            <% addresses.forEach(function (a) { %>
              <label class="address-option">
                <input type="radio" name="address_id" value="<%= a.id %>" data-address-choice
                       <%= selected === String(a.id) ? 'checked' : '' %>>
                <span class="address-option__body">
                  <span class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <strong class="font-display"><%= a.recipient_name %></strong>
                    <% if (a.label) { %><span class="text-mute" style="font-size:.78rem"><%= a.label %></span><% } %>
                    <% if (a.is_default) { %><span class="address-badge">Default</span><% } %>
                  </span>
                  <span class="text-soft" style="white-space:pre-line; font-size:.86rem; line-height:1.55"><%= formatAddress(a) %></span>
                </span>
              </label>
            <% }) %>

            <label class="address-option">
              <input type="radio" name="address_id" value="new" data-address-choice
                     <%= selected === 'new' ? 'checked' : '' %>>
              <span class="address-option__body">
                <strong class="font-display">Use a new address</strong>
              </span>
            </label>
          </div>
        <% } else { %>
          <input type="hidden" name="address_id" value="new">
        <% } %>

        <%# Without JavaScript this stays visible, and the server still checks it %>
        <div data-new-address>
          <%- include('../account/partials/address-fields', {
                values: values,
                conditional: addresses.length > 0
              }) %>

          <% if (canSaveAddress) { %>
            <div class="form-check mt-3">
              <input class="form-check-input" type="checkbox" name="save_address" id="save_address"
                     <%= saveAddress ? 'checked' : '' %>>
              <label class="form-check-label" for="save_address">Save this address for next time</label>
            </div>
          <% } %>
        </div>
      </div>

      <div class="surface p-4 mb-3">
        <div class="panel-title mb-2">Payment</div>
        <p class="text-mute mb-0" style="font-size:.86rem">
          You'll enter your card details on Stripe's secure payment page after this step.
          Nothing is charged until you confirm there.
        </p>
      </div>

      <button class="btn btn-accent btn-lg w-100">Continue to payment</button>
    </form>
  </div>

  <!-- SUMMARY -->
  <div class="col-lg-5">
    <div class="surface p-4">
      <div class="panel-title mb-3">Order summary</div>

      <% items.forEach(item => { %>
        <div class="d-flex gap-3 mb-3">
          <img src="<%= item.image_url || 'https://placehold.co/80x107/EEF2FF/8785A8?text=D' %>"
               alt="<%= item.name %>" width="48" height="64"
               style="border-radius:8px; object-fit:cover; flex-shrink:0">
          <div style="flex:1; min-width:0">
            <div class="font-display fw-semibold" style="font-size:.88rem"><%= item.name %></div>
            <div class="text-mute" style="font-size:.76rem">
              <%= item.color %> · <%= item.size %> × <%= item.quantity %>
            </div>
          </div>
          <div class="font-display fw-semibold" style="font-size:.88rem">
            $<%= (Number(item.current_price) * item.quantity).toFixed(2) %>
          </div>
        </div>
      <% }) %>

      <div class="pt-3" style="border-top:1px solid var(--line)">
        <div class="d-flex justify-content-between mb-2" style="font-size:.9rem">
          <span class="text-mute">Subtotal</span>
          <span class="fw-semibold">$<%= subtotal.toFixed(2) %></span>
        </div>
        <div class="d-flex justify-content-between mb-3" style="font-size:.9rem">
          <span class="text-mute">Delivery</span>
          <span class="fw-semibold">$<%= shippingFee.toFixed(2) %></span>
        </div>
        <div class="d-flex justify-content-between align-items-baseline pt-3"
             style="border-top:1px solid var(--line)">
          <span class="font-display fw-bold">Total</span>
          <span class="font-display fw-bold" style="font-size:1.3rem">$<%= total.toFixed(2) %></span>
        </div>
      </div>

      <a href="/cart" class="btn btn-plain w-100 mt-4">Back to cart</a>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>