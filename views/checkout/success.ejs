<%- include('../partials/header') %>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="text-center mb-4">
      <h1>Thank you for your order</h1>
      <p class="text-muted">
        Order #<%= order.id %> &middot; A confirmation has been sent to <%= order.email %>
      </p>
    </div>

    <% if (order.status === 'pending') { %>
      <div class="alert alert-info">
        We're still confirming your payment. This page will show the final status shortly &mdash;
        refresh in a moment.
      </div>
    <% } %>

    <div class="card">
      <div class="card-body">
        <h5 class="card-title mb-3">Order summary</h5>

        <% items.forEach(item => { %>
          <div class="d-flex justify-content-between mb-2">
            <div>
              <%= item.product_name %><br>
              <span class="text-muted small"><%= item.color %> · <%= item.size %> × <%= item.quantity %></span>
            </div>
            <div>$<%= (Number(item.unit_price) * item.quantity).toFixed(2) %></div>
          </div>
        <% }) %>

        <hr>
        <div class="d-flex justify-content-between">
          <span>Subtotal</span><span>$<%= Number(order.subtotal).toFixed(2) %></span>
        </div>
        <div class="d-flex justify-content-between">
          <span>Shipping</span><span>$<%= Number(order.shipping_fee).toFixed(2) %></span>
        </div>
        <hr>
        <div class="d-flex justify-content-between fs-5 fw-bold">
          <span>Total</span><span>$<%= Number(order.total).toFixed(2) %></span>
        </div>

        <hr>
        <h6>Shipping to</h6>
        <p class="mb-0 text-muted">
          <%= order.shipping_name %><br>
          <%= order.shipping_address %>
        </p>
      </div>
    </div>

    <div class="text-center mt-4">
      <a href="/" class="btn btn-dark">Continue shopping</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>