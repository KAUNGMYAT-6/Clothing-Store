<%- include('../partials/header') %>

<div class="error-page">
  <div class="error-page__code">403</div>
  <h1 class="mb-3">You don't have access to this</h1>
  <p class="text-mute mb-4">
    This area is restricted. If you think you should be able to see it,
    try signing in with a different account.
  </p>
  <div class="d-flex gap-2 justify-content-center flex-wrap">
    <a href="/" class="btn btn-brand"><span>Go home</span></a>
    <% if (!user) { %>
      <a href="/login" class="btn btn-outline-brand">Log in</a>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>